{
  "id": "modern-warm",
  "name": "Modern Warm",
  "description": "Warm oak floors, off-white walls, terracotta and brass accents.",
  "palette": {
    "wall": "#f3ece3",
    "wallAccent": "#c96f4a",
    "floor": "#c8a274",
    "floorWarm": "#d8b087",
    "floorStone": "#cfc6ba",
    "floorTile": "#dcd6cc",
    "wood": "#a9764a",
    "woodDark": "#6f4a2f",
    "woodLight": "#d2a877",
    "fabric": "#b5603f",
    "fabricSoft": "#e0c3a8",
    "linen": "#f7f1e8",
    "metal": "#c9a227",
    "steel": "#9fa6ad",
    "glass": "#bcd5e0",
    "ceramic": "#fbfbf9",
    "dark": "#3c3833",
    "selection": "#ffb300"
  },
  "materials": {
    "matte": { "kind": "standard", "roughness": 0.9, "metalness": 0 },
    "wall": { "extends": "matte", "color": "$wall", "roughness": 0.95 },
    "wallAccent": { "extends": "wall", "color": "$wallAccent" },
    "floorOak": { "extends": "matte", "color": "$floor", "roughness": 0.65, "side": "double" },
    "floorWarm": { "extends": "floorOak", "color": "$floorWarm" },
    "floorStone": { "extends": "floorOak", "color": "$floorStone", "roughness": 0.8 },
    "floorTile": {
      "kind": "physical",
      "color": "$floorTile",
      "roughness": 0.25,
      "metalness": 0.05,
      "clearcoat": 0.6,
      "clearcoatRoughness": 0.3,
      "side": "double"
    },
    "wood": { "extends": "matte", "color": "$wood", "roughness": 0.55 },
    "woodDark": { "extends": "wood", "color": "$woodDark" },
    "woodLight": { "extends": "wood", "color": "$woodLight" },
    "upholstery": { "extends": "matte", "color": "$fabric", "roughness": 0.95 },
    "upholsterySoft": { "extends": "upholstery", "color": "$fabricSoft" },
    "linen": { "extends": "matte", "color": "$linen", "roughness": 0.98 },
    "brass": { "kind": "standard", "color": "$metal", "roughness": 0.25, "metalness": 0.9 },
    "steel": { "kind": "standard", "color": "$steel", "roughness": 0.35, "metalness": 0.7 },
    "glass": {
      "kind": "standard",
      "color": "$glass",
      "roughness": 0.05,
      "metalness": 0.1,
      "transparent": true,
      "opacity": 0.3
    },
    "ceramic": { "kind": "standard", "color": "$ceramic", "roughness": 0.2, "metalness": 0.05 },
    "dark": { "extends": "matte", "color": "$dark", "roughness": 0.6 }
  },
  "roles": {
    "wall.primary": "wall",
    "wall.accent": "wallAccent",
    "floor.default": "floorOak",
    "floor.living_room": "floorWarm",
    "floor.dining": "floorWarm",
    "floor.bedroom": "floorOak",
    "floor.kitchen": "floorStone",
    "floor.bathroom": "floorTile",
    "floor.lobby": "floorStone",
    "floor.balcony": "floorStone",
    "floor.sitout": "floorStone",
    "door.default": "wood",
    "door.panel": "wood",
    "door.frame": "linen",
    "door.handle": "brass",
    "window.default": "linen",
    "window.frame": "linen",
    "window.glass": "glass",
    "furniture.default": "wood",
    "furniture.wood": "wood",
    "furniture.dark": "dark",
    "furniture.soft": "upholstery",
    "furniture.metal": "steel",
    "furniture.sanitary": "ceramic",
    "bedding.mattress": "linen",
    "bedding.pillow": "upholsterySoft"
  },
  "nodeTypes": {
    "bed_double": "woodDark",
    "bed_single": "woodDark",
    "wardrobe": "woodDark",
    "sofa": "upholstery",
    "coffee_table": "wood",
    "dining_table": "wood",
    "chair": "woodLight",
    "kitchen_counter": "dark",
    "fridge": "steel",
    "tv_unit": "dark",
    "toilet": "ceramic",
    "washbasin": "ceramic"
  },
  "rooms": {
    "bathroom": { "materials": { "wall": "floorTile" } },
    "kitchen": { "materials": { "wall": "wall" } },
    "living_room": { "materials": { "chair": "upholsterySoft" } }
  },
  "view3D": {
    "background": "#f1e9df",
    "shadows": true,
    "ambient": { "color": "#fff3e4", "intensity": 0.75 },
    "hemisphere": { "color": "#fff6ec", "groundColor": "#c8b49c", "intensity": 0.6 },
    "directional": [
      { "color": "#ffe7c7", "intensity": 1.7, "position": [8, 14, 6] },
      { "color": "#cdd7e5", "intensity": 0.35, "position": [-10, 8, -6] }
    ],
    "grid": { "cellColor": "#d6c9b8", "sectionColor": "#a8927a" }
  },
  "view2D": {
    "background": "#f7f2ea",
    "ambient": { "color": "#ffffff", "intensity": 1.1 },
    "grid": { "cellColor": "#ddd2c4", "sectionColor": "#b09b83" },
    "wallOpacity": 0.9
  },
  "fallback": "matte"
}
