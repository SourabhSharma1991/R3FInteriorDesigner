{
  "id": "scandinavian",
  "name": "Scandinavian",
  "description": "Pale birch, chalk-white walls, cool grey textiles and lots of light.",
  "palette": {
    "wall": "#fbfbf9",
    "wallAccent": "#dfe6e9",
    "floor": "#e3d3bb",
    "floorPale": "#efe3cf",
    "floorGrey": "#dcdcd8",
    "floorTile": "#eef1f2",
    "wood": "#d9bd92",
    "woodDark": "#9c7c54",
    "woodLight": "#eddcbf",
    "fabric": "#9fb0bb",
    "fabricSoft": "#cfd8de",
    "linen": "#ffffff",
    "metal": "#b8bfc5",
    "steel": "#aeb6bc",
    "glass": "#d4e6ee",
    "ceramic": "#ffffff",
    "dark": "#4c565e",
    "selection": "#4d94ff"
  },
  "materials": {
    "matte": { "kind": "standard", "roughness": 0.92, "metalness": 0 },
    "wall": { "extends": "matte", "color": "$wall", "roughness": 0.97 },
    "wallAccent": { "extends": "wall", "color": "$wallAccent" },
    "floorBirch": { "extends": "matte", "color": "$floor", "roughness": 0.6, "side": "double" },
    "floorPale": { "extends": "floorBirch", "color": "$floorPale" },
    "floorGrey": { "extends": "floorBirch", "color": "$floorGrey", "roughness": 0.85 },
    "floorTile": {
      "kind": "physical",
      "color": "$floorTile",
      "roughness": 0.2,
      "metalness": 0.02,
      "clearcoat": 0.5,
      "clearcoatRoughness": 0.25,
      "side": "double"
    },
    "wood": { "extends": "matte", "color": "$wood", "roughness": 0.5 },
    "woodDark": { "extends": "wood", "color": "$woodDark" },
    "woodLight": { "extends": "wood", "color": "$woodLight" },
    "upholstery": { "extends": "matte", "color": "$fabric", "roughness": 0.96 },
    "upholsterySoft": { "extends": "upholstery", "color": "$fabricSoft" },
    "linen": { "extends": "matte", "color": "$linen", "roughness": 0.99 },
    "brushedMetal": { "kind": "standard", "color": "$metal", "roughness": 0.4, "metalness": 0.75 },
    "steel": { "kind": "standard", "color": "$steel", "roughness": 0.3, "metalness": 0.8 },
    "glass": {
      "kind": "standard",
      "color": "$glass",
      "roughness": 0.03,
      "metalness": 0.1,
      "transparent": true,
      "opacity": 0.25
    },
    "ceramic": { "kind": "standard", "color": "$ceramic", "roughness": 0.15, "metalness": 0.03 },
    "dark": { "extends": "matte", "color": "$dark", "roughness": 0.7 }
  },
  "roles": {
    "wall.primary": "wall",
    "wall.accent": "wallAccent",
    "floor.default": "floorBirch",
    "floor.living_room": "floorPale",
    "floor.dining": "floorPale",
    "floor.bedroom": "floorBirch",
    "floor.kitchen": "floorGrey",
    "floor.bathroom": "floorTile",
    "floor.lobby": "floorGrey",
    "floor.balcony": "floorGrey",
    "floor.sitout": "floorGrey",
    "door.default": "woodLight",
    "door.panel": "woodLight",
    "door.frame": "linen",
    "door.handle": "brushedMetal",
    "window.default": "linen",
    "window.frame": "linen",
    "window.glass": "glass",
    "furniture.default": "wood",
    "furniture.wood": "wood",
    "furniture.dark": "dark",
    "furniture.soft": "upholstery",
    "furniture.metal": "steel",
    "furniture.sanitary": "ceramic",
    "bedding.mattress": "linen",
    "bedding.pillow": "upholsterySoft"
  },
  "nodeTypes": {
    "bed_double": "woodLight",
    "bed_single": "woodLight",
    "wardrobe": "wood",
    "sofa": "upholstery",
    "coffee_table": "woodLight",
    "dining_table": "woodLight",
    "chair": "wood",
    "kitchen_counter": "floorGrey",
    "fridge": "steel",
    "tv_unit": "dark",
    "toilet": "ceramic",
    "washbasin": "ceramic"
  },
  "rooms": {
    "bathroom": { "materials": { "wall": "floorTile" } },
    "bedroom": { "materials": { "wall": "wallAccent" } },
    "kitchen": { "materials": { "wall": "wall" } }
  },
  "view3D": {
    "background": "#f2f5f7",
    "shadows": true,
    "ambient": { "color": "#ffffff", "intensity": 0.95 },
    "hemisphere": { "color": "#ffffff", "groundColor": "#cfd6db", "intensity": 0.7 },
    "directional": [
      { "color": "#fdfdff", "intensity": 1.5, "position": [6, 15, 8] },
      { "color": "#dbe6f0", "intensity": 0.45, "position": [-9, 9, -7] }
    ],
    "grid": { "cellColor": "#d7dde1", "sectionColor": "#9aa5ad" }
  },
  "view2D": {
    "background": "#ffffff",
    "ambient": { "color": "#ffffff", "intensity": 1.2 },
    "grid": { "cellColor": "#e2e7ea", "sectionColor": "#aab3ba" },
    "wallOpacity": 0.95
  },
  "fallback": "matte"
}
